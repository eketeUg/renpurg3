# Telegram Bot Token from @BotFather
TELEGRAM_TOKEN=your_telegram_bot_token

# Default pin for wallet encryption/access
DEFAULT_WALLET_PIN=your_default_pin

# USDC Mint Address on Solana (e.g., 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU for devnet)
USDC_MINT_ADDRESS=your_usdc_mint_address

# MongoDB Connection String
MONGO_URI=mongodb_uri

# Kora Node RPC and Provider Public Key
KORA_RPC_URL=your_kora_rpc_url
KORA_PROVIDER_PUBKEY=your_kora_provider_pubkey

# Solana RPC and WebSocket URLs
SOLANA_RPC_URL=your_solana_rpc_url
SOLANA_WS_URL=your_solana_ws_url
SOLANA_SCAN_URL=https://explorer.solana.com/

# Bot Profile URL
BOT_URL=https://t.me/your_bot_username
